{
    "name": "schemastud/laravel-data-schemas",
    "description": "Generate JSON Schemas from Laravel Data objects with validation attributes",
    "keywords": [
        "laravel",
        "json-schema",
        "spatie",
        "laravel-data",
        "validation",
        "schema-generation"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Stephen Rushing",
            "email": "stephen@rushing.dev"
        }
    ],
    "require": {
        "php": "^8.3",
        "galbar/jsonpath": "^3.0",
        "illuminate/console": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/routing": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "opis/json-schema": "^2.3",
        "rushing/laravel-pipeline-registry": "dev-main",
        "rushing/laravel-popcorn": "dev-main",
        "rushing/php-popcorn": "dev-main",
        "schemastud/php-json-ns": "*",
        "spatie/laravel-data": "^4.0|^5.0",
        "symfony/finder": "^6.0|^7.0|^8.0"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../rushing/laravel-pipeline-registry",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../../rushing/laravel-popcorn",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../../rushing/php-popcorn",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../php-json-ns",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "vcs",
            "url": "https://github.com/stephenr85/laravel-popcorn.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/stephenr85/laravel-pipeline-registry.git"
        },
        {
            "type": "git",
            "url": "https://github.com/schemastud/php-json-ns.git"
        },
        {
            "type": "git",
            "url": "https://github.com/stephenr85/php-popcorn.git"
        }
    ],
    "require-dev": {
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^11.0|^12.0",
        "wikimedia/composer-merge-plugin": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "Schemastud\\DataSchemas\\": "src/",
            "Rushing\\LaravelDataSchemasScribe\\Attributes\\": "src/Http/Attributes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Schemastud\\DataSchemas\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Schemastud\\DataSchemas\\LaravelDataSchemasServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        },
        "merge-plugin": {
            "include": [
                "composer.local.json"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true,
            "wikimedia/composer-merge-plugin": true
        }
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit",
        "pint": "@php -d memory_limit=512M vendor/bin/pint"
    }
}
